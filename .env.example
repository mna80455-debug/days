# Firebase Configuration for Days App (days-app)
# Copy this file to '.env' and fill in your Firebase values.

VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=days-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=days-app
VITE_FIREBASE_STORAGE_BUCKET=days-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID
